Enum cash_flow_type {
  INCOME
  EXPENSE
}

Table customer {
  customer_id int [pk, increment]
  name varchar(100) [not null]
  email varchar(100) [unique, not null]
}

Table address {
  address_id int [pk, increment]
  customer_id int [not null]
  city varchar(50) [not null]
}

Table category {
  category_id int [pk, increment]
  name varchar(50) [not null]
}

Table product {
  product_id int [pk, increment]
  category_id int [not null]
  name varchar(100) [not null]
  price decimal(12, 2) [not null]
  stock int [not null]
}

Table cart {
  cart_id int [pk, increment]
  customer_id int [unique, not null]
}

Table cart_item {
  cart_item_id int [pk, increment]
  cart_id int [not null]
  product_id int [not null]
  quantity int [not null]
}

Table voucher {
  voucher_id int [pk, increment]
  code varchar(50) [unique, not null]
  discount_amount decimal(12, 2) [not null]
}

Table "order" {
  order_id int [pk, increment]
  customer_id int [not null]
  voucher_id int
  address_id int [not null]
  total_price decimal(12, 2) [not null]
  status varchar(30) [not null]
}

Table order_detail {
  order_detail_id int [pk, increment]
  order_id int [not null]
  product_id int [not null]
  quantity int [not null]
  price_per_item decimal(12, 2) [not null]
}

Table payment_gateway {
  gateway_id int [pk, increment]
  name varchar(50) [not null]
}

Table payment {
  payment_id int [pk, increment]
  order_id int [unique, not null]
  gateway_id int [not null]
  amount decimal(12, 2) [not null]
  status varchar(30) [not null]
}

Table shipment {
  shipment_id int [pk, increment]
  order_id int [unique, not null]
  tracking_number varchar(100)
  status varchar(30) [not null]
}

Table cash_flow {
  cash_flow_id int [pk, increment]
  type cash_flow_type [not null]
  amount decimal(12, 2) [not null]
}

Table withdrawal {
  withdrawal_id int [pk, increment]
  amount decimal(12, 2) [not null]
  bank_account varchar(50) [not null]
  status varchar(30) [not null]
}

Ref: address.customer_id > customer.customer_id [delete: cascade]
Ref: product.category_id > category.category_id
Ref: customer.customer_id - cart.customer_id [delete: cascade]
Ref: cart_item.cart_id > cart.cart_id [delete: cascade]
Ref: cart_item.product_id > product.product_id
Ref: "order".customer_id > customer.customer_id
Ref: "order".voucher_id > voucher.voucher_id
Ref: "order".address_id > address.address_id
Ref: order_detail.order_id > "order".order_id [delete: cascade]
Ref: order_detail.product_id > product.product_id
Ref: "order".order_id - payment.order_id
Ref: payment.gateway_id > payment_gateway.gateway_id
Ref: "order".order_id - shipment.order_id